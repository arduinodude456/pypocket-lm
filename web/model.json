    },
    "<BOS>\u241fKW:for": {
      "NAME:<id>": 2
    },
    "<BOS>\u241fKW:if": {
      "NAME:<id>": 2
    },
    "<BOS>\u241fKW:try": {
      "OP::": 2
    },
    "<BOS>\u241fNAME:<id>": {
      "OP:=": 2
    },
    "<DEDENT>\u241f<DEDENT>": {
      "<END>": 2,
      "KW:return": 2
    },
    "<DEDENT>\u241fFN:print": {
