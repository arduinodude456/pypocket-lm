{
  "format": "pypocket-ngram-v1",
  "order": 3,
  "transitions": {
    "<BOS>": {
      "<BOS>": 20,
      "KW:class": 2,
      "KW:def": 10,
      "KW:for": 2,
      "KW:if": 2,
      "KW:try": 2,
      "NAME:<id>": 2
    },
