    },
    "<DEDENT>\u241fKW:def": {
      "NAME:<id>": 2
    },
    "<DEDENT>\u241fKW:else": {
      "OP::": 2
    },
    "<DEDENT>\u241fKW:except": {
      "NAME:<id>": 2
    },
    "<DEDENT>\u241fKW:return": {
      "KW:None": 2
    },
    "<INDENT>\u241fFN:print": {
      "OP:(": 8
    },
    "<INDENT>\u241fKW:def": {
      "NAME:<id>": 2
    },
    "<INDENT>\u241fKW:for": {
      "NAME:<id>": 2
    },
    "<INDENT>\u241fKW:if": {
      "NAME:<id>": 2
    },
    "<INDENT>\u241fKW:return": {
      "NAME:<id>": 6,
      "OP:f\"": 2
    },
    "<INDENT>\u241fNAME:<id>": {
      "OP:.": 4,
      "OP:=": 6
    },
    "<NEWLINE>\u241f<DEDENT>": {
      "<DEDENT>": 4,
      "<END>": 16,
      "FN:print": 2,
      "KW:def": 2,
      "KW:else": 2,
      "KW:except": 2
    },
    "<NEWLINE>\u241f<INDENT>": {
      "FN:print": 8,
      "KW:def": 2,
      "KW:for": 2,
      "KW:if": 2,
      "KW:return": 8,
      "NAME:<id>": 10
    },
    "<NEWLINE>\u241fKW:for": {
      "NAME:<id>": 2
    },
    "FN:int\u241fOP:(": {
      "NAME:<id>": 2
    },
    "FN:print\u241fOP:(": {
      "LIT:<str>": 6,
      "NAME:<id>": 4
    },
    "KW:None\u241f<NEWLINE>": {
      "<DEDENT>": 2
    },
    "KW:class\u241fNAME:<id>": {
      "OP::": 2
    },
    "KW:def\u241fNAME:<id>": {
      "OP:(": 14
    },
    "KW:else\u241fOP::": {
      "<NEWLINE>": 2
    },
    "KW:except\u241fNAME:<id>": {
      "OP::": 2
    },
    "KW:for\u241fNAME:<id>": {
      "KW:in": 6
    },
    "KW:if\u241fNAME:<id>": {
      "OP:==": 2,
      "OP:>=": 2
    },
    "KW:in\u241fNAME:<id>": {
      "OP::": 6
    },
    "KW:return\u241fKW:None": {
      "<NEWLINE>": 2
    },
    "KW:return\u241fNAME:<id>": {
      "<NEWLINE>": 2,
      "OP:%": 2,
      "OP:+": 2
    },
    "KW:return\u241fOP:f\"": {
      "OP:Hello ": 2
    },
    "KW:try\u241fOP::": {
      "<NEWLINE>": 2
    },
    "LIT:<num>\u241f<NEWLINE>": {
      "<DEDENT>": 8,
      "KW:for": 2
    },
    "LIT:<num>\u241fOP::": {
      "<NEWLINE>": 2
    },
    "LIT:<num>\u241fOP:==": {
      "LIT:<num>": 2
    },
    "LIT:<str>\u241fOP:)": {
      "<NEWLINE>": 4
    },
    "LIT:<str>\u241fOP:,": {
      "NAME:<id>": 2
    },
    "NAME:<id>\u241f<NEWLINE>": {
      "<DEDENT>": 6
    },
    "NAME:<id>\u241fKW:in": {
      "NAME:<id>": 6
    },
    "NAME:<id>\u241fOP:%": {
      "LIT:<num>": 2
    },
    "NAME:<id>\u241fOP:(": {
      "NAME:<id>": 14
    },
    "NAME:<id>\u241fOP:)": {
      "<NEWLINE>": 8,
      "OP::": 14
    },
    "NAME:<id>\u241fOP:+": {
      "NAME:<id>": 4
    },
    "NAME:<id>\u241fOP:+=": {
      "LIT:<num>": 2
    },
    "NAME:<id>\u241fOP:,": {
      "NAME:<id>": 4
    },
    "NAME:<id>\u241fOP:.": {
      "NAME:<id>": 4
    },
    "NAME:<id>\u241fOP::": {
      "<NEWLINE>": 12
    },
    "NAME:<id>\u241fOP:=": {
      "FN:int": 2,
      "LIT:<num>": 6,
      "NAME:<id>": 2
    },
    "NAME:<id>\u241fOP:==": {
      "NAME:<id>": 2
    },
    "NAME:<id>\u241fOP:>=": {
      "LIT:<num>": 2
    },
    "NAME:<id>\u241fOP:}": {
      "OP:\"": 2
    },
    "OP:\"\u241f<NEWLINE>": {
      "<DEDENT>": 2
    },
    "OP:%\u241fLIT:<num>": {
      "OP:==": 2
    },
    "OP:(\u241fLIT:<str>": {
      "OP:)": 4,
      "OP:,": 2
    },
    "OP:(\u241fNAME:<id>": {
      "OP:)": 16,
      "OP:,": 4
    },
    "OP:)\u241f<NEWLINE>": {
      "<DEDENT>": 10,
      "<END>": 2
    },
    "OP:)\u241fOP::": {
      "<NEWLINE>": 14
    },
    "OP:+=\u241fLIT:<num>": {
      "<NEWLINE>": 2
    },
    "OP:+\u241fNAME:<id>": {
      "<NEWLINE>": 4
    },
    "OP:,\u241fNAME:<id>": {
      "OP:)": 6
    },
    "OP:.\u241fNAME:<id>": {
      "OP:+=": 2,
      "OP:=": 2
    },
    "OP::\u241f<NEWLINE>": {
      "<INDENT>": 32
    },
    "OP:==\u241fLIT:<num>": {
      "<NEWLINE>": 2
    },
    "OP:==\u241fNAME:<id>": {
      "OP::": 2
    },
    "OP:=\u241fFN:int": {
      "OP:(": 2
    },
    "OP:=\u241fLIT:<num>": {
      "<NEWLINE>": 6
    },
    "OP:=\u241fNAME:<id>": {
      "OP:+": 2
    },
    "OP:>=\u241fLIT:<num>": {
      "OP::": 2
    },
    "OP:Hello \u241fOP:{": {
      "NAME:<id>": 2
    },
    "OP:f\"\u241fOP:Hello ": {
      "OP:{": 2
    },
    "OP:{\u241fNAME:<id>": {
      "OP:}": 2
    },
    "OP:}\u241fOP:\"": {
      "<NEWLINE>": 2
    }
  },
  "vocab": [
